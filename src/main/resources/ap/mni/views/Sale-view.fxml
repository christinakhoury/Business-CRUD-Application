                <Button fx:id="removeSaleBtn" layoutX="142.0" layoutY="239.0" prefHeight="26.0" prefWidth="86.0" text="Remove " />
                <Button fx:id="clearTableBtn" layoutX="247.0" layoutY="239.0" prefHeight="26.0" prefWidth="86.0" text="Clear Table" />
