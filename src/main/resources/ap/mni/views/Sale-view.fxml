            </columns>
        </TableView>


        <AnchorPane layoutX="14.0" layoutY="58.0" prefHeight="365.0" prefWidth="380.0">
            <children>
                <Label layoutX="10.0" layoutY="50.0" text="Product Name:" textFill="#0d0943">
               <font>
                  <Font size="14.0" />
               </font></Label>
                <TextField fx:id="productNameField" layoutX="140.0" layoutY="45.0" prefWidth="150.0" />

                <Label layoutX="10.0" layoutY="90.0" text="Quantity:" textFill="#0d0943">
