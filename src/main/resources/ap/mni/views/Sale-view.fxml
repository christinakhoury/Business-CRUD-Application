<AnchorPane prefHeight="417.0" prefWidth="830.0" style="-fx-background-color: #ffa100;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ap.mni.controllers.SalesAndOffersController">

